# Backend REST & Socket.IO base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5001

# GraphQL endpoint for browser queries
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5001/graphql

# Internal SSR-only URL for server-side GraphQL fetches (same machine)
GRAPHQL_INTERNAL_URL=http://localhost:5001/graphql
